<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.max.secall-reindex</string>
  <!--
    ⚠️ 2026-07-30에 비활성화. `~/Library/LaunchAgents/archive/`로 옮겨뒀고 이 파일은 기록용이다.
    끈 이유 두 가지:
      ① 이 잡이 임베딩을 매주 전부 지운다. `reindex --from-vault`는 전 세션을 재수집하고
         재수집 경로엔 `DELETE FROM turn_vectors WHERE session_id = ?1`이 있다. 벡터는
         볼트에 없고 DB에만 있는 파생물이라 "볼트에서 재구축"은 곧 벡터 파괴다.
         실측: 38,300턴 중 turn_vectors 32개만 생존(10시간짜리 embed 결과가 사라짐).
      ② 애초에 이 잡의 존재 이유였던 드리프트 원인(iCloud fileprovider 쓰기 충돌)이
         볼트를 로컬 ~/99_memory로 옮기면서 사라졌다.
    드리프트가 의심되면 수동으로 돌리고, 그 직후 `secall embed`를 반드시 이어 붙일 것.
  -->
  <!--
    주간 인덱스 재구축. daily sync가 iCloud fileprovider 쓰기 충돌
    ("Resource deadlock avoided")로 검색 인덱스에서 세션을 몇 개씩 누락시키는
    드리프트를 볼트(원본, 불변)에서 통째로 재구축해 자동 복구한다.
    볼트 md가 원본이고 DB는 파생 캐시라 안전한 연산.
    plist 규칙은 sync 잡과 동일 (직접 exec + FDA + kiwi env) — com.max.secall-sync.plist 참고.
  -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/max/.local/bin/secall</string>
    <string>reindex</string>
    <string>--from-vault</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>KIWI_LIBRARY_PATH</key><string>/Users/max/.local/share/secall/kiwi/libkiwi.dylib</string>
    <key>KIWI_MODEL_PATH</key><string>/Users/max/.local/share/secall/kiwi/model/models/cong/base</string>
    <!-- embedding.backend=ort일 때 ONNX Runtime 위치 — 없으면 ort가 패닉. sync 잡과 동일 이유 -->
    <key>ORT_DYLIB_PATH</key><string>/opt/homebrew/lib/libonnxruntime.dylib</string>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/Users/max/.local/bin</string>
  </dict>
  <!-- 매주 월요일 09:10 (일일 sync 09:00과 겹치면 iCloud 쓰기 경합 재현 위험 — 10분 띄움) -->
  <key>StartCalendarInterval</key>
  <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>10</integer></dict>
  <key>StandardOutPath</key><string>/tmp/secall-reindex.log</string>
  <key>StandardErrorPath</key><string>/tmp/secall-reindex.err</string>
</dict>
</plist>
