<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.max.secall-wiki</string>
  <!--
    주간 위키 갱신. `secall wiki update`는 아직 어떤 wiki 페이지에도
    referenced 되지 않은 세션만 증분 처리하므로(전체 재생성 아님) 매주
    실행이 가볍다. --backend claude는 내부적으로 `claude -p` 서브프로세스를
    새로 띄워 iCloud 볼트(wiki/)에 직접 쓰므로 sync/reindex와 동일한 TCC
    이슈가 재발할 수 있음 — 최초 kickstart로 행 여부 검증 필요.
    wiki.backends.claude.model=sonnet은 config.toml에 이미 명시됨.
    --no-pull: seCall git sync를 쓰지 않으므로 git 관련 동작 생략.
  -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/max/.local/bin/secall</string>
    <string>wiki</string>
    <string>update</string>
    <string>--backend</string>
    <string>claude</string>
    <string>--no-pull</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>KIWI_LIBRARY_PATH</key><string>/Users/max/.local/share/secall/kiwi/libkiwi.dylib</string>
    <key>KIWI_MODEL_PATH</key><string>/Users/max/.local/share/secall/kiwi/model/models/cong/base</string>
    <!-- embedding.backend=ort일 때 ONNX Runtime 위치. wiki update가 임베딩을 타는지는 미확인이라 예방 차원 -->
    <key>ORT_DYLIB_PATH</key><string>/opt/homebrew/lib/libonnxruntime.dylib</string>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/Users/max/.local/bin</string>
  </dict>
  <!--
    매주 화요일 13:00. 이전 금 16:30 스케줄은 등록(07-15) 이후 한 번도 성공하지
    못했음 — `claude -p`가 업무 시간대에 구독 세션 한도에 걸려 exit 1
    (2026-07-24 /tmp/secall-wiki.err 실측). 상태 확인은
    `launchctl list | grep secall-wiki`의 두 번째 컬럼(마지막 exit 코드).
  -->
  <key>StartCalendarInterval</key>
  <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>13</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/tmp/secall-wiki.log</string>
  <key>StandardErrorPath</key><string>/tmp/secall-wiki.err</string>
</dict>
</plist>
